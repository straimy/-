{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GunGloryOnline",
  "version": "0.2.0",
  "identifier": "online.gunglory.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"GunGloryOnline","width":1180,"height":720,"minWidth":900,"minHeight":620,"resizable":true,"fullscreen":false}],
    "security": {"csp":"default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": false,
    "windows": {"nsis":{"installMode":"currentUser"}}
  }
}
