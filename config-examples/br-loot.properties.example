# GunGloryOnline Battle Royale loot tables
# Format per entry: item_id|weight|min_count|max_count
# Multiple entries are comma-separated.
#
# This example intentionally uses vanilla placeholder IDs only to document the format.
# Production BR balance should use approved GGO/JEG item IDs after the BR map/content pass.

common=minecraft:bread|10|1|2,minecraft:arrow|8|4|10
military=minecraft:iron_sword|4|1|1,minecraft:crossbow|3|1|1
medical=minecraft:golden_apple|3|1|1,minecraft:cooked_beef|8|1|3
rare=minecraft:diamond_sword|1|1|1,minecraft:golden_apple|5|1|2
