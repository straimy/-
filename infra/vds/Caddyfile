{$GGO_SITE_HOST} {
    encode zstd gzip

    @accountApi path /api/v1/*
    handle @accountApi {
        reverse_proxy account-api:8080
    }

    handle_path /skins/* {
        root * /srv/ggo/skins
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options nosniff
        file_server
    }

    handle {
        root * /srv/ggo/site
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

{$GGO_UPDATES_HOST} {
    encode zstd gzip
    root * /srv/ggo/updates

    @manifest path /manifests/*
    header @manifest Cache-Control "no-cache, no-store, must-revalidate"

    @api path /api/*
    header @api Cache-Control "no-cache, max-age=0"

    @launcherLatest path /launcher/latest.json
    header @launcherLatest Cache-Control "no-cache, no-store, must-revalidate"

    @immutableFiles path /files/* /launcher/*/*
    header @immutableFiles Cache-Control "public, max-age=31536000, immutable"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }

    file_server
}
