{$GGO_SITE_HOST} {
    encode zstd gzip
    root * /srv/ggo/site
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    try_files {path} /index.html
    file_server
}

{$GGO_UPDATES_HOST} {
    encode zstd gzip
    root * /srv/ggo/updates

    @manifest path /manifests/*
    header @manifest Cache-Control "no-cache, no-store, must-revalidate"

    @api path /api/*
    header @api Cache-Control "no-cache, max-age=0"

    @launcherLatest path /launcher/latest.json
    header @launcherLatest Cache-Control "no-cache, no-store, must-revalidate"

    @immutableFiles path /files/* /launcher/*/*
    header @immutableFiles Cache-Control "public, max-age=31536000, immutable"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }

    file_server
}
