{$GGO_HOST} {
    encode zstd gzip
    root * /srv/ggo/public

    @manifest path /manifests/*
    header @manifest Cache-Control "no-cache, no-store, must-revalidate"

    @api path /api/*
    header @api Cache-Control "no-cache, max-age=0"

    @files path /files/*
    header @files Cache-Control "public, max-age=31536000, immutable"

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }

    file_server
}
