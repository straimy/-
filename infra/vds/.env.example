# Public DNS names pointed to the VDS. Caddy obtains HTTPS automatically.
GGO_SITE_HOST=ggo.kvicloud.ru
GGO_UPDATES_HOST=updates.ggo.kvicloud.ru

# Raw game TCP endpoint. Keep this DNS-only in Cloudflare.
GGO_PLAY_HOST=play.ggo.kvicloud.ru
GGO_GAME_PORT=24842

# Public base URL used by release publishers and launcher builds.
GGO_PUBLIC_BASE_URL=https://updates.ggo.kvicloud.ru

# Backend database settings. Keep the real password only in the VDS .env file.
POSTGRES_DB=ggo
POSTGRES_USER=ggo
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Account access-token signing secret. Generate at least 32 random bytes and never commit the real value.
GGO_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Game server memory. 4G leaves room for Caddy/API/PostgreSQL/Redis on the current 8 GB VDS.
GGO_GAME_XMS=1G
GGO_GAME_XMX=4G
