# GGO Stage100 transition policy.
# Keep Stage96 accepted during the first Stage100 smoke. Remove Stage96 only after the
# Stage100 launcher -> frontend -> online path has been proven on a real client.
GGO_ALLOWED_CLIENT_BUILDS=runtime-stage96,runtime-stage100
GGO_ALLOWED_CORE_SHA256=c3c580b456ad5bd17144188a557d6d50ce2d3c23eee5685f7fdf28b632c1f2a1
GGO_ALLOWED_UI_SHA256=783b0a6c572de0f98cd2e882eb3f98b2014e760062f50818110cea5300ee2852,75259d89f12e0f36add0bd82f02674aaad3313e7f807ae38ef2791026ca9e4fc

# Ticket-bound auth remains mandatory. Do not expose GGO_SERVER_KEY in logs or client files.
# Preserve the existing GGO_SERVER_KEY and GGO_AUTH_API_URL values when applying this policy.
# GGO_ENFORCE_CLIENT_BUILD=1
