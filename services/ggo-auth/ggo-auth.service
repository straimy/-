[Unit]
Description=GunGloryOnline Account API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ggo-auth
Group=ggo-auth
WorkingDirectory=/opt/ggo-auth
Environment=PYTHONUNBUFFERED=1
Environment=GGO_AUTH_HOST=127.0.0.1
Environment=GGO_AUTH_PORT=8787
Environment=GGO_PUBLIC_URL=https://ggo.kvicloud.ru
Environment=GGO_AUTH_DB=/var/lib/ggo-auth/auth.db
EnvironmentFile=-/etc/ggo-auth.env
ExecStart=/usr/bin/python3 /opt/ggo-auth/secure_server.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ggo-auth

[Install]
WantedBy=multi-user.target
